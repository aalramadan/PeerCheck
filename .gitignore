# Confidential data never goes to GitHub: submissions, reviews, exports, and reports.
/submissions/
/reviews/
/results/
/my_files/
*.pdf
review_*.xml
*.xlsx
*.xls
*.csv
*.jsonl
*.json
*.html
!tests/fixtures/**/*.pdf
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.json
# The page of peercheck gui and the data files of the external tools.
!src/gui.html
!external/**/*.json
!external/**/*.html
# The made-up examples and their reports, which the README and the live demo use.
!examples/**/*.pdf
!examples/**/*.csv
!examples/**/*.html
# Test resources of the revised SIGSOFT checker, from its upstream repository.
!external/submission-checker/src/test/resources/*

# Downloaded models, databases, and tools.
.cache/

# Python, Java, and LaTeX build files.
.venv/
__pycache__/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
external/submission-checker/target/
