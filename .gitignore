# Confidential conference data never goes to GitHub: submissions, reviews, exports, and reports.
/submissions/
/reviews/
/results/
/my_files/
*.pdf
review_*.xml
*.xlsx
*.xls
*.csv
*.jsonl
*.json
*.html
!tests/fixtures/**/*.pdf
!tests/fixtures/**/review_*.xml
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.xlsx
!tests/fixtures/**/*.json
# The page of peercheck gui and the data files of the external tools.
!src/gui.html
!external/**/*.json
!external/**/*.html
# The made-up samples that the README and the live demo use.
!samples/**/*.pdf
!samples/**/*.csv
!samples/**/review_*.xml
!samples/*.csv
# The reports of the samples, which the live demo serves.
!examples/*.xlsx
!examples/*.html
# Test resources of the revised SIGSOFT checker, from its upstream repository.
!external/submission-checker/src/test/resources/*

# Downloaded models, databases, and tools.
.cache/

# Python, Java, and LaTeX build files.
__pycache__/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
external/submission-checker/target/
tests/fixtures/**/*.aux
tests/fixtures/**/*.log
tests/fixtures/**/*.out
